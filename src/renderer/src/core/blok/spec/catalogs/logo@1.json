     "kind": "ANY",
     "required": false,
     "description": "Radius."
    },
    {
     "key": "stroke",
     "kind": "STRING",
     "required": false,
     "description": "Stroke paint: ink, muted, brand, brand-strong, brand-soft, surface, none (the viewer's palette), url(#gradient), or under an SVG any colour."
    },
    {
     "key": "strokeDasharray",
     "kind": "STRING",
     "required": false,
     "description": "Dash pattern, e.g. \"4 2\"."
    },
    {
     "key": "strokeLinecap",
     "kind": "STRING",
