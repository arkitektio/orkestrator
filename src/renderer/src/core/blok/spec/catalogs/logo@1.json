     "kind": "ANY",
     "required": false,
     "description": "Centre x."
    },
    {
     "key": "cy",
     "kind": "ANY",
     "required": false,
     "description": "Centre y."
    },
    {
     "key": "fill",
     "kind": "STRING",
     "required": false,
     "description": "Fill paint: ink, muted, brand, brand-strong, brand-soft, surface, none (the viewer's palette), url(#gradient), or under an SVG any colour."
    },
    {
     "key": "fillOpacity",
     "kind": "ANY",
     "required": false,
     "description": "Fill opacity, 0 to 1."
    },
    {
     "key": "fillRule",
     "kind": "STRING",
     "required": false,
     "description": "Which parts of a self-intersecting shape are inside.",
