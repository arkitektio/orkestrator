[
 {
  "id": "Scene",
  "component": "Scene",
  "children": [
   {
    "id": "scope",
    "component": "Model",
    "props": [
     {
      "key": "src",
      "static_value": null,
      "dynamic_value": {
       "literal": null,
       "path": "self.assets.scope"
      }
     }
    ],
    "children": [
     {
      "id": "scope/Move[0]",
      "component": "Move",
      "props": [
       {
        "key": "node",
        "static_value": "stage_x"
       },
       {
        "key": "axis",
        "static_value": "x"
       },
       {
        "key": "value",
        "dynamic_value": {
         "path": "self.Stage.x"
        }
       },
       {
        "key": "animateTo",
        "dynamic_value": {
         "path": "self.Stage.target_x"
        }
       },
       {
        "key": "speed",
        "dynamic_value": {
         "path": "self.Stage.speed"
        }
       }
      ]
     },
     {
      "id": "scope/Show[0]",
      "component": "Show",
      "props": [
       {
        "key": "node",
        "static_value": "incubator"
       },
       {
        "key": "when",
        "dynamic_value": {
         "path": "self.Stage.mounted"
        }
       }
      ]
     },
     {
      "id": "scope/OnClick[0]",
      "component": "OnClick",
      "props": [
       {
        "key": "node",
        "static_value": "turret"
       },
       {
        "key": "open",
        "static_value": "turret_panel"
       }
      ]
     },
     {
      "id": "scope/Popout[0]",
      "component": "Popout",
      "props": [
       {
        "key": "node",
        "static_value": "laser_out"
       },
       {
        "key": "trigger",
        "static_value": "hover"
       }
      ],
      "children": [
       {
        "id": "scope/Popout[0]/Card[0]",
        "component": "Card",
        "children": [
         {
          "id": "scope/Popout[0]/Card[0]/CardContent[0]",
          "component": "CardContent",
          "children": [
           {
            "id": "scope/Popout[0]/Card[0]/CardContent[0]/Badge[0]",
            "component": "Badge",
            "props": [
             {
              "key": "text",
              "static_value": "Laser"
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "id": "arm",
    "component": "Robot",
    "props": [
     {
      "key": "src",
      "static_value": null,
      "dynamic_value": {
       "literal": null,
       "path": "self.assets.arm"
      }
     },
     {
      "key": "origin",
      "static_value": "0.6 0 0"
     },
     {
      "key": "onJointChange",
      "agent_call": {
       "dependency": "self",
       "operation": "move_joint",
       "arguments": [
        {
         "key": "name",
         "value_path": "$event.name"
        },
        {
         "key": "position",
         "value_path": "$event.value"
        }
       ]
      }
     }
    ],
    "children": [
     {
      "id": "arm/Glow[0]",
      "component": "Glow",
      "props": [
       {
        "key": "node",
        "static_value": "tool0"
       },
       {
        "key": "on",
        "dynamic_value": {
         "path": "self.Stage.mounted"
        }
       }
      ]
     },
     {
      "id": "arm/Attach[0]",
      "component": "Attach",
      "props": [
       {
        "key": "node",
        "static_value": "sample"
       },
       {
        "key": "to",
        "static_value": "scope:stage_x"
       },
       {
        "key": "when",
        "dynamic_value": {
         "path": "self.Stage.mounted"
        }
       }
      ]
     }
    ]
   }
  ]
 }
]